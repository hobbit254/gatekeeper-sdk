// The examples build against the SDK in this repository; a copied example
// uses the released module from its go.mod (ADR-0132).
go 1.26.0

toolchain go1.26.11

use (
	./examples/go-api
	./go
	./go/gkgin
	./tools/guidecheck
)

// Go looks up a required version even when the workspace has the module, so the
// examples' required version is replaced with this checkout; move it with the
// example's go.mod (tools/release-dry-run.sh go checks they match).
replace github.com/hobbit254/gatekeeper-sdk/go v0.1.0 => ./go
