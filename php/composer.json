{
  "name": "gatekeeper/laravel",
  "description": "Gatekeeper PHP SDK and Laravel middleware: verify access tokens, resolve permissions, guard routes (ADR-0038)",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "firebase/php-jwt": "^7.2",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^2.0",
    "illuminate/http": "^11.0 || ^12.0",
    "illuminate/support": "^11.0 || ^12.0",
    "psr/simple-cache": "^3.0",
    "spomky-labs/aes-key-wrap": "7.0.0",
    "web-token/jwt-library": "4.2.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Gatekeeper\\Admin\\": "admin/lib/",
      "Gatekeeper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gatekeeper\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Gatekeeper\\Laravel\\GatekeeperServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
