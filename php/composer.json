{
  "name": "gatekeeper/laravel",
  "description": "Gatekeeper PHP SDK and Laravel middleware: verify access tokens, resolve permissions, guard routes (ADR-0038)",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.2",
    "psr/simple-cache": "^3.0",
    "illuminate/http": "^11.0 || ^12.0",
    "illuminate/support": "^11.0 || ^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": { "psr-4": { "Gatekeeper\\": "src/" } },
  "autoload-dev": { "psr-4": { "Gatekeeper\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": ["Gatekeeper\\Laravel\\GatekeeperServiceProvider"] } },
  "config": { "sort-packages": true }
}
